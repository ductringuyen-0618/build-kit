# Copy to frontend/.env.local. NEXT_PUBLIC_* reaches the browser (baked in at
# build time); everything else is server-only.
# Port `next start` listens on. App Platform and the Dockerfile set this too.
PORT=3000
# Separate backend URL for local dev. Leave unset in production so the app
# calls same-origin paths behind the App Platform ingress.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-only, when Next.js owns data access. The deploy injects a managed URL.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
