# Copy to backend/.env for local development. Parsed once in src/config.ts.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres locally; App Platform binds ${db.DATABASE_URL}.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# CORS: exact origins, comma separated.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin actions require this header value.
ADMIN_TOKEN=change-me-locally-only
