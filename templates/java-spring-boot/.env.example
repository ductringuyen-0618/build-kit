# Copy to backend/.env for local runs (export before `./gradlew bootRun`).
# Read only through @ConfigurationProperties / application.yml placeholders.

PORT=8080
SPRING_PROFILES_ACTIVE=dev              # dev | test | prod

# JDBC URL. App Platform binds ${db.JDBC_DATABASE_URL}; local default is H2 in memory.
SPRING_DATASOURCE_URL=jdbc:h2:mem:dev;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# CORS: exact origins, comma separated.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin actions require this header value.
APP_ADMIN_TOKEN=change-me-locally-only
