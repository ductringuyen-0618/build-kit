# Copy to backend/.env for local runs (or export the values). Never commit .env.
# Port the server listens on; application.yml maps it to server.port.
PORT=8080
# JDBC URL. Leave unset for the in-memory H2 default; set for local Postgres.
# Credentials may ride in the URL (?user=...&password=...) or in the two
# optional SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD variables.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/app?user=postgres&password=postgres
# Comma-separated origins allowed by CORS (the frontend's dev URL locally).
APP_ALLOWED_ORIGINS=http://localhost:5173
# Optional: header value required by admin-only routes (declared as a SECRET in app-component.yaml).
# APP_ADMIN_TOKEN=change-me-locally-only
