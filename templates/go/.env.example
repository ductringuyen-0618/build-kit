# Copy to backend/.env and export it (or use direnv). Never commit .env.
# Port the server listens on. App Platform and the Dockerfile set this too.
PORT=8080
# Connection string for pgx / database/sql. The deploy injects a managed URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
# Comma-separated origins allowed by CORS (the frontend's dev URL locally).
ALLOWED_ORIGINS=http://localhost:5173
# Optional: header value required by admin-only routes (declared as a SECRET in app-component.yaml).
# ADMIN_TOKEN=change-me-locally-only
