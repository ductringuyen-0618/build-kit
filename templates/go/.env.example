# Copy to backend/.env and export (or use direnv). Read only in internal/config.

PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

# Postgres locally; App Platform binds ${db.DATABASE_URL}.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable

# CORS: exact origins, comma separated.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin actions require this header value.
ADMIN_TOKEN=change-me-locally-only
