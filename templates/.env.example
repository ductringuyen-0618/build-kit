# Copy to backend/.env for local development. Never commit backend/.env.
# Every variable here is read through Settings (core/config.py); nothing
# else reads os.environ directly.

ENVIRONMENT=development            # development | testing | production
LOG_LEVEL=INFO

# Database. Local default is SQLite; App Platform injects ${db.DATABASE_URL}.
DATABASE_URL=sqlite:///./data/app.db

# CORS. Exact origins, comma separated. Never "*" with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional external providers. Leave blank to use the in-process fake.
LLM_PROVIDER=fake                  # fake | groq | ollama | anthropic
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# Admin actions (wipe, retention runs) require this header value.
ADMIN_TOKEN=change-me-locally-only
